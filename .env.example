# Copy to .env. Never commit .env.
GEMINI_API_KEY=your-key
# Secrets referenced in goals as {name:secret} are read from NAME in upper case.
# ParaBank's built-in demo customer john (recreated each time ParaBank resets its data).
PASSWORD=demo
# SauceDemo (public shop demo) password for the second example.
SAUCE_PASSWORD=secret_sauce
